from os import PathLike
from types import TracebackType
from typing import Any, Callable, Literal, Optional, Protocol, Union

import numpy as np
import numpy.typing as npt

__version__: str

class Error(Exception): ...
class OpenError(Error): ...
class InvalidPathError(Error): ...
class AssetError(Error): ...
class UnsupportedTypeError(Error): ...
class FeatureDisabledError(Error): ...
class SchemaError(Error): ...
class InvalidValueError(Error): ...
class WriteError(Error): ...

class AssetPath:
    authored: str
    resolved: str

class Bound:
    min: list[float]
    max: list[float]
    matrix: npt.NDArray[np.float64]
    aligned_min: list[float]
    aligned_max: list[float]

class Camera:
    transform: npt.NDArray[np.float64]
    projection: str
    horizontal_aperture: float
    vertical_aperture: float
    horizontal_aperture_offset: float
    vertical_aperture_offset: float
    focal_length: float
    near: float
    far: float
    clipping_planes: list[list[float]]
    f_stop: float
    focus_distance: float
    exposure_scale: float
    horizontal_fov: float
    vertical_fov: float
    view_matrix: npt.NDArray[np.float64]
    projection_matrix: npt.NDArray[np.float64]

class Light:
    type_name: str
    color: list[float]
    intensity: float
    exposure: float
    normalize: bool
    color_temperature: Optional[float]
    radiance: list[float]
    radius: Optional[float]
    width: Optional[float]
    height: Optional[float]
    length: Optional[float]
    angle: Optional[float]
    texture: Optional[str]
    cone_angle: Optional[float]
    cone_softness: Optional[float]
    focus: Optional[float]

class GeomSubset:
    prim: Prim
    family: str
    element_type: str
    indices: npt.NDArray[np.int32]

class Triangles:
    point_indices: npt.NDArray[np.int32]
    corner_indices: npt.NDArray[np.int32]
    faces: npt.NDArray[np.int32]

class Normals:
    normals: npt.NDArray[np.float32]
    interpolation: str
    authored: bool

class AttributeInfo:
    type_name: str
    uniform: bool
    custom: bool
    has_value: bool
    has_authored_value: bool
    might_be_time_varying: bool

class Primvar:
    name: str
    type_name: str
    value: Any
    interpolation: str
    element_size: int
    indexed: bool
    source: Prim

class Instances:
    prototypes: list[Prim]
    proto_indices: npt.NDArray[np.int32]
    ids: npt.NDArray[np.int64]
    transforms: npt.NDArray[np.float64]

class SkelBinding:
    skeleton: Prim
    animation: Optional[Prim]
    skinned: list[Prim]

class SkeletonPose:
    joints: list[str]
    parents: npt.NDArray[np.int32]
    bind: npt.NDArray[np.float64]
    rest_local: npt.NDArray[np.float64]
    local: npt.NDArray[np.float64]
    skel: npt.NDArray[np.float64]
    skinning: npt.NDArray[np.float64]

class SkinBinding:
    skeleton: Prim
    joint_indices: npt.NDArray[np.int32]
    joint_weights: npt.NDArray[np.float32]
    influences_per_point: int
    rigid: bool
    geom_bind_transform: npt.NDArray[np.float64]
    skinning_method: str
    blend_shapes: list[str]
    blend_shape_weights: npt.NDArray[np.float32]

class SubShape:
    blend_shape: int
    weight: float
    point_offsets: npt.NDArray[np.float32]
    normal_offsets: npt.NDArray[np.float32]

class BlendShapes:
    point_indices: list[npt.NDArray[np.int32]]
    sub_shapes: list[SubShape]

class Prim:
    path: str
    name: str
    type_name: str
    kind: str
    specifier: str
    active: bool
    loaded: bool
    defined: bool
    abstract_: bool
    model: bool
    instanceable: bool
    instance: bool
    instance_proxy: bool
    prototype_root: bool
    in_prototype: bool
    parent: Optional[Prim]
    prototype: Optional[Prim]
    applied_schemas: list[str]
    def instances(self) -> list[Prim]: ...
    def children(
        self,
        *,
        include_inactive: bool = False,
        include_unloaded: bool = False,
        include_undefined: bool = False,
        include_abstract: bool = False,
        instance_proxies: bool = False,
    ) -> list[Prim]: ...
    def is_a(self, schema: str) -> bool: ...
    def has_api(self, schema: str) -> bool: ...
    def attribute_names(self, *, authored_only: bool = False) -> list[str]: ...
    def relationship_names(self, *, authored_only: bool = False) -> list[str]: ...
    def get(self, name: str, time: Optional[float] = None) -> Any: ...
    def attribute_info(self, name: str) -> Optional[AttributeInfo]: ...
    def time_samples(self, name: str) -> list[float]: ...
    def connections(self, name: str) -> list[str]: ...
    def targets(self, name: str, *, forwarded: bool = False) -> list[str]: ...
    def metadata(self, key: str) -> Any: ...
    def attribute_metadata(self, name: str, key: str) -> Any: ...
    def world_transform(self, time: Optional[float] = None) -> npt.NDArray[np.float64]: ...
    def local_transform(self, time: Optional[float] = None) -> tuple[npt.NDArray[np.float64], bool]: ...
    def primvar_names(self) -> list[str]: ...
    def primvar(self, name: str, time: Optional[float] = None) -> Optional[Primvar]: ...
    def bound_material(self, purpose: str = "") -> Optional[Prim]: ...
    purpose: str
    def visible(self, time: Optional[float] = None) -> bool: ...
    def world_bound(self, time: Optional[float] = None, purposes: list[str] = ...) -> Optional[Bound]: ...
    def local_bound(self, time: Optional[float] = None, purposes: list[str] = ...) -> Optional[Bound]: ...
    def untransformed_bound(self, time: Optional[float] = None, purposes: list[str] = ...) -> Optional[Bound]: ...
    def camera(self, time: Optional[float] = None) -> Optional[Camera]: ...
    def light(self, time: Optional[float] = None) -> Optional[Light]: ...
    def geom_subsets(self, time: Optional[float] = None) -> list[GeomSubset]: ...
    def triangulate(self, time: Optional[float] = None) -> Optional[Triangles]: ...
    def normals(self, time: Optional[float] = None) -> Optional[Normals]: ...
    def metadata_keys(self, key: str) -> list[str]: ...
    def attribute_metadata_keys(self, name: str, key: str) -> list[str]: ...
    def set(self, name: str, value: Any, time: Optional[float] = None) -> None: ...
    def create_attribute(self, name: str, type_name: str, *, uniform: bool = False) -> None: ...
    def block(self, name: str) -> None: ...
    def clear(self, name: str) -> None: ...
    def set_connections(self, name: str, targets: list[str]) -> None: ...
    def set_targets(self, name: str, targets: list[str]) -> None: ...
    def apply_api(self, schema: str) -> None: ...
    def set_type_name(self, type_name: str) -> None: ...
    def set_active(self, active: bool) -> None: ...
    def set_kind(self, kind: str) -> None: ...
    def set_instanceable(self, instanceable: bool) -> None: ...
    def add_reference(self, asset_path: str = "", prim_path: str = "") -> None: ...
    def add_payload(self, asset_path: str, prim_path: str = "") -> None: ...
    def add_inherit(self, path: str) -> None: ...
    def add_specialize(self, path: str) -> None: ...
    def set_variant_selection(self, variant_set: str, variant: str) -> None: ...
    def set_local_transform(self, matrix: Any, time: Optional[float] = None) -> None: ...
    def set_world_transform(self, matrix: Any, time: Optional[float] = None) -> None: ...
    def set_trs(
        self, translate: Any, orient: Any = None, scale: Any = None, time: Optional[float] = None
    ) -> None: ...
    def set_mesh(
        self, points: Any, face_vertex_counts: Any, face_vertex_indices: Any, time: Optional[float] = None
    ) -> None: ...
    def set_primvar(
        self,
        name: str,
        type_name: str,
        value: Any,
        interpolation: Literal["constant", "uniform", "varying", "vertex", "faceVarying"] = "constant",
        indices: Any = None,
        element_size: int = 0,
        time: Optional[float] = None,
    ) -> None: ...
    def bind_material(self, material: Prim, purpose: str = "") -> None: ...
    def remove_api(self, schema: str) -> None: ...
    def add_target(self, name: str, target: str) -> None: ...
    def rename(self, new_name: str) -> None: ...
    def reparent(self, new_parent: Prim) -> None: ...
    def edit_variant(self, variant_set: str, variant: str) -> None: ...
    variant_sets: dict[str, list[str]]
    def instancer_instances(
        self, time: Optional[float] = None, *, include_prototype_transform: bool = True, apply_visibility: bool = True
    ) -> Optional[Instances]: ...
    def skeleton_pose(self, time: Optional[float] = None) -> Optional[SkeletonPose]: ...
    def skin_binding(self, time: Optional[float] = None) -> Optional[SkinBinding]: ...
    def blend_shapes(self, time: Optional[float] = None) -> Optional[BlendShapes]: ...
    def skinned_points(self, time: Optional[float] = None) -> Optional[npt.NDArray[np.float32]]: ...

class Resolver(Protocol):
    def resolve(self, asset_path: str, anchor: Optional[str]) -> Optional[str]: ...
    def read(self, resolved_path: str) -> Optional[bytes]: ...

class EditBatch:
    def __enter__(self) -> EditBatch: ...
    def __exit__(
        self,
        exc_type: Optional[type[BaseException]],
        exc: Optional[BaseException],
        tb: Optional[TracebackType],
    ) -> bool: ...

class Stage:
    pseudo_root: Prim
    default_prim: Optional[Prim]
    start_time_code: float
    end_time_code: float
    time_codes_per_second: float
    frames_per_second: float
    layer_identifiers: list[str]
    composition_errors: list[str]
    @staticmethod
    def open(
        path: Union[str, PathLike[str]],
        *,
        load_payloads: bool = True,
        resolver: Optional[Resolver] = None,
        schemas: list[Union[str, PathLike[str]]] = ...,
    ) -> Stage: ...
    def load(self, prim: Prim, *, with_descendants: bool = True) -> None: ...
    def unload(self, prim: Prim) -> None: ...
    def loadable(self, root: Optional[Prim] = None) -> list[Prim]: ...
    def prim(self, path: str) -> Optional[Prim]: ...
    def traverse(
        self,
        root: Optional[Prim] = None,
        *,
        include_inactive: bool = False,
        include_unloaded: bool = False,
        include_undefined: bool = False,
        include_abstract: bool = False,
        instance_proxies: bool = False,
    ) -> list[Prim]: ...
    def prototypes(self) -> list[Prim]: ...
    def skel_bindings(self, root: Optional[Prim] = None) -> list[SkelBinding]: ...
    def physics(
        self,
        *,
        include: Optional[list[Prim]] = None,
        exclude: Optional[list[Prim]] = None,
        si_units: bool = False,
    ) -> dict[str, Any]: ...
    def mass_colliders(self, body: Prim) -> list[Prim]: ...
    def mass_properties(
        self, body: Prim, mass_info: Callable[[Prim], Optional[dict[str, Any]]]
    ) -> dict[str, Any]: ...
    def metadata(self, key: str) -> Any: ...
    def has_authored_metadata(self, key: str) -> bool: ...
    def read_asset(self, resolved_path: str) -> bytes: ...
    def metadata_keys(self, key: str) -> list[str]: ...
    edit_target: str
    @staticmethod
    def create_new(
        path: Union[str, PathLike[str]],
        *,
        resolver: Optional[Resolver] = None,
        schemas: list[Union[str, PathLike[str]]] = ...,
    ) -> Stage: ...
    @staticmethod
    def create_in_memory(
        *, resolver: Optional[Resolver] = None, schemas: list[Union[str, PathLike[str]]] = ...
    ) -> Stage: ...
    def save(self) -> None: ...
    def export(self, path: Union[str, PathLike[str]]) -> None: ...
    def export_layer(self, layer: str, path: Union[str, PathLike[str]]) -> None: ...
    def export_package(self, path: Union[str, PathLike[str]]) -> None: ...
    def write_physics(self, physics: dict[str, Any], *, poses: bool = False) -> None: ...
    def write_body_mass(self, prim: Prim, mass: dict[str, Any]) -> None: ...
    def move_prim(self, prim: Prim, new_parent: Prim, new_name: Optional[str] = None) -> None: ...
    def export_bytes(
        self, format: Literal["usda", "usdc", "usdz"] = "usda", layer: Optional[str] = None
    ) -> bytes: ...
    def set_edit_target(self, layer: str) -> None: ...
    def add_sublayer(self, asset_path: str, *, create: bool = False) -> str: ...
    def edit(self) -> EditBatch: ...
    def begin_edit(self) -> None: ...
    def commit_edit(self) -> None: ...
    def discard_edit(self) -> None: ...
    def define_prim(self, path: str, type_name: str = "") -> Prim: ...
    def override_prim(self, path: str) -> Prim: ...
    def remove_prim(self, prim: Prim) -> bool: ...
    def set_default_prim(self, prim: Prim) -> None: ...
    def set_up_axis(self, axis: str) -> None: ...
    def set_meters_per_unit(self, meters: float) -> None: ...
    def set_kilograms_per_unit(self, kilograms: float) -> None: ...
    def set_time_range(
        self,
        start: float,
        end: float,
        *,
        time_codes_per_second: Optional[float] = None,
        frames_per_second: Optional[float] = None,
    ) -> None: ...
    def set_documentation(self, text: str) -> None: ...

def features() -> list[str]: ...

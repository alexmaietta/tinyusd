function(tinyusd_platform out)
  if(WIN32)
    set(os windows)
  elseif(APPLE)
    set(os macos)
  else()
    set(os linux)
  endif()
  string(TOLOWER "${CMAKE_SYSTEM_PROCESSOR}" arch)
  if(arch MATCHES "^(amd64|x64|x86_64)$")
    set(arch x86_64)
  elseif(arch MATCHES "^(arm64|aarch64)$")
    set(arch aarch64)
  endif()
  set(${out} "${os}-${arch}" PARENT_SCOPE)
endfunction()

function(tinyusd_static_system_libs out)
  if(WIN32)
    set(libs kernel32 ntdll userenv ws2_32 dbghelp)
  elseif(APPLE)
    set(libs iconv System c m)
  else()
    set(libs gcc_s util rt pthread m dl c)
  endif()
  set(${out} "${libs}" PARENT_SCOPE)
endfunction()

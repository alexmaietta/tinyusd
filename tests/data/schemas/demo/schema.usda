#usda 1.0
(
    subLayers = [
        @usd/schema.usda@,
        @usdGeom/schema.usda@
    ]
)

over "GLOBAL" (
    customData = {
        string libraryName = "demo"
        string libraryPath = "."
        bool skipCodeGeneration = true
        bool useLiteralIdentifier = true
    }
) {
}

class DemoWidget "DemoWidget" (
    inherits = </Xformable>
) {
    float demo:size = 2.5
    uniform token demo:mode = "fast" (
        allowedTokens = ["fast", "accurate"]
    )
}

class "DemoTagAPI" (
    inherits = </APISchemaBase>
    customData = {
        token apiSchemaType = "singleApply"
    }
) {
    int demo:tag = 7
}

class "DemoSlotAPI" (
    inherits = </APISchemaBase>
    customData = {
        token apiSchemaType = "multipleApply"
        token propertyNamespacePrefix = "slot"
    }
) {
    float weight = 1
}

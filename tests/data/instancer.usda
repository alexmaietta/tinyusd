        double3 xformOp:translate = (0, 0, 100)
        uniform token[] xformOpOrder = ["xformOp:translate"]

        def Scope "Prototypes"
        {
            def Xform "Pine"
            {
                double3 xformOp:translate = (0, 1, 0)
                uniform token[] xformOpOrder = ["xformOp:translate"]

                def Cube "Trunk"
                {
                }
            }

            def Sphere "Oak"
            {
            }
        }
    }

    def PointInstancer "Rocks"
    {
        quatf[] orientations = [(1, 0, 0, 0), (0, 0, 0, 1)]
        point3f[] positions.timeSamples = {
            0: [(0, 0, 0), (1, 0, 0)],
            10: [(0, 10, 0), (1, 10, 0)],
        }
        int[] protoIndices = [0, 0]
        rel prototypes = </World/Rocks/Rock>

        def Cube "Rock"
        {
